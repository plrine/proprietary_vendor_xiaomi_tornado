on boot
    mkdir /data/vendor/nfc_socket 0770 nfc nfc
    mkdir /data/vendor/nfc 0777 nfc nfc
    mkdir /data/vendor/nfc/param 0777 nfc nfc
    chmod 0666 /dev/tms_nfc
    chown nfc nfc /dev/tms_nfc
    chmod 0666 /sys/nfc/chip_name
    chown nfc nfc /sys/nfc/chip_name

on early-init && property:ro.boot.product.hardware.sku=rgle
    setprop ro.vendor.nfc.dispatch_optim 2
    setprop ro.vendor.nfc.wallet_fusion 1
    setprop ro.vendor.nfc.repair 1
    setprop ro.vendor.nfc.mibeam 1
    setprop ro.vendor.se.type HCE,UICC

on early-init && property:ro.boot.product.hardware.sku=rgle_ss
    setprop ro.vendor.nfc.dispatch_optim 2
    setprop ro.vendor.nfc.wallet_fusion 1
    setprop ro.vendor.nfc.repair 1
    setprop ro.vendor.nfc.mibeam 1
    setprop ro.vendor.se.type HCE,UICC

on early-init && property:ro.boot.product.hardware.sku=rglec
    setprop ro.vendor.nfc.dispatch_optim 2
    setprop ro.vendor.nfc.wallet_fusion 1
    setprop ro.vendor.nfc.repair 1
    setprop ro.vendor.nfc.mibeam 1
    setprop ro.vendor.se.type HCE,UICC

on early-init && property:ro.boot.product.hardware.sku=rglec_ss
    setprop ro.vendor.nfc.dispatch_optim 2
    setprop ro.vendor.nfc.wallet_fusion 1
    setprop ro.vendor.nfc.repair 1
    setprop ro.vendor.nfc.mibeam 1
    setprop ro.vendor.se.type HCE,UICC

on early-init && property:ro.boot.product.hardware.sku=rgl
    setprop ro.vendor.nfc.dispatch_optim 2
    setprop ro.vendor.nfc.wallet_fusion 1
    setprop ro.vendor.nfc.repair 1
    setprop ro.vendor.nfc.mibeam 1
    setprop ro.vendor.se.type HCE,UICC

on early-init && property:ro.boot.product.hardware.sku=rgl_ss
    setprop ro.vendor.nfc.dispatch_optim 2
    setprop ro.vendor.nfc.wallet_fusion 1
    setprop ro.vendor.nfc.repair 1
    setprop ro.vendor.nfc.mibeam 1
    setprop ro.vendor.se.type HCE,UICC

on early-init && property:ro.boot.product.hardware.sku=rglx
    setprop ro.vendor.nfc.dispatch_optim 2
    setprop ro.vendor.nfc.wallet_fusion 1
    setprop ro.vendor.nfc.repair 1
    setprop ro.vendor.nfc.mibeam 1
    setprop ro.vendor.se.type HCE,UICC

on early-init && property:ro.boot.product.hardware.sku=rglx_ss
    setprop ro.vendor.nfc.dispatch_optim 2
    setprop ro.vendor.nfc.wallet_fusion 1
    setprop ro.vendor.nfc.repair 1
    setprop ro.vendor.nfc.mibeam 1
    setprop ro.vendor.se.type HCE,UICC

on early-init && property:ro.boot.product.hardware.sku=rjp
    setprop ro.vendor.nfc.dispatch_optim 1
    setprop ro.vendor.se.type eSE,HCE,UICC
    setprop ro.vendor.se.chip.model SN220T
    setprop ro.vendor.nfc.disable.i2c false
    setprop ro.vendor.se.info 19-1010212
    setprop ro.vendor.nfc.aclog 1
    setprop ro.vendor.nfc.repair 1
